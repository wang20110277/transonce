# Backend (Python/FastAPI) — copy to .env and adjust.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transonce

# Agent runtime: mock | auto | claude (Claude Code --print) | opencode (opencode run)
# mock works offline; set claude/opencode after logging in to that CLI.
AGENT_PROVIDER=mock
AGENT_TIMEOUT_MS=180000
AGENT_FALLBACK_MOCK=true

# Auth / crypto
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=168

# Super admin bootstrapped by seed.py
ADMIN_EMAIL=admin@transonce.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=超级管理员

# Demo tenant / data
SEED_DEMO=true

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

PORT=8000
